extends Node
## Art layer. Every picture in the game is requested here by key.
## If res://assets/<key with dots as dashes>.png exists it is used; otherwise the caller draws a placeholder shape.
## So the game is fully playable with no artwork, and art is added by dropping PNG files into assets/.
## Example: key "bg.van" -> res://assets/bg-van.png. See ART_KEYS.md for the full list.

var _cache := {}

func tex(key: String) -> Texture2D:
	if _cache.has(key):
		return _cache[key]
	var path := "res://assets/" + key.replace(".", "-") + ".png"
	var t: Texture2D = null
	if ResourceLoader.exists(path):
		t = load(path)
	_cache[key] = t
	return t

## Sound effects: res://assets/sfx/<name>.wav (or .ogg), generated by tools/sfx/make_sfx.py (see tools/sfx/README.md).
## vary nudges the pitch a little each time (so a run of the same sound does not sound mechanical); gap is the least
## time in seconds between two plays of it (so a finger dragging across the dough does not machine-gun).
var _players := {}
var _last := {}
func sfx(sound: String, vary := false, gap := 0.0) -> void:
	if Game.s.get("mute", false):
		return
	var now := Time.get_ticks_msec() / 1000.0
	if gap > 0.0 and now - float(_last.get(sound, -100.0)) < gap: return
	_last[sound] = now
	if not _players.has(sound):
		var st = sound_stream(sound)
		var p: AudioStreamPlayer = null
		if st != null:
			p = AudioStreamPlayer.new()
			p.stream = st
			add_child(p)
		_players[sound] = p
	var pl: AudioStreamPlayer = _players[sound]
	if pl != null:
		pl.pitch_scale = randf_range(0.93, 1.07) if vary else 1.0
		pl.play()

## a sound's file: res://assets/sfx/<name>.wav, or .ogg (the music), or null if there is none
func sound_stream(sound: String) -> AudioStream:
	for ext in [".wav", ".ogg"]:
		var path: String = "res://assets/sfx/" + sound + ext
		if ResourceLoader.exists(path): return load(path)
	return null

## A short buzz in your hand on a phone (no effect on a computer), when Vibration is on in Settings: a light tick
## for pressing dough, a longer buzz for something that needs you (a pizza burning, the phone ringing).
var buzzes := 0                           # how many have been asked for (for the tests)
func buzz(ms: int) -> void:
	if not Game.s.get("vibrate", true): return
	buzzes += 1
	Input.vibrate_handheld(ms)

## The background loops (fire, murmur, room) and the music: whoever is on screen calls loop() every frame with how
## loud each should be, 0 (off) to 1. It eases there, so it swells and fades rather than jumping; one nobody has asked
## for this frame fades away by itself (so leaving a screen fades its sounds out, and the music carries on from the
## title into the kitchen without starting again). Sound off silences them; Music off silences the music.
var _loops := {}
var _want := {}
func loop(sound: String, level: float, _dt: float = 0.016) -> void:
	_want[sound] = maxf(level, float(_want.get(sound, 0.0)))
	if level > 0.001 and not _loops.has(sound):
		var st = sound_stream(sound)
		var p: AudioStreamPlayer = null
		if st != null:
			# the stream loops itself, to the sample (they are made to join without a seam): no gap, no restart
			if st is AudioStreamOggVorbis: st.loop = true
			elif st is AudioStreamWAV:
				st.loop_mode = AudioStreamWAV.LOOP_FORWARD
				st.loop_begin = 0
				st.loop_end = int(round(st.get_length() * st.mix_rate))
			p = AudioStreamPlayer.new()
			p.stream = st
			p.volume_db = -60.0
			add_child(p)
		_loops[sound] = p

func _process(dt: float) -> void:
	for k in _loops:
		var p: AudioStreamPlayer = _loops[k]
		if p == null: continue
		var level: float = _want.get(k, 0.0)
		if Game.s.get("mute", false) or (k == "music" and not Game.s.get("music", true)): level = 0.0
		var want := linear_to_db(maxf(level, 0.0001))
		p.volume_db = lerpf(p.volume_db, want, 1.0 - exp(-dt * (1.5 if k == "music" else 3.0)))
		if level > 0.001 and not p.playing: p.play(0.0 if k == "music" else randf() * p.stream.get_length())
		elif level <= 0.001 and p.volume_db < -45.0 and p.playing: p.stop()
	_want.clear()

## silence every loop at once (the tests use it)
func stop_loops() -> void:
	for k in _loops:
		var p: AudioStreamPlayer = _loops[k]
		if p != null:
			p.stop()
			p.volume_db = -60.0

## A 3D model by key: res://assets/models/<key with dots as dashes>.glb (or .gltf / .tscn), instanced.
## null if there is none yet, and the 3D kitchen builds a placeholder shape instead. See ART_KEYS.md.
var _models := {}
func model(key: String) -> Node3D:
	if not _models.has(key):
		_models[key] = null
		for ext in [".glb", ".gltf", ".tscn"]:
			var path: String = "res://assets/models/" + key.replace(".", "-") + ext
			if ResourceLoader.exists(path):
				_models[key] = load(path)
				break
	var ps = _models[key]
	if ps is PackedScene: return ps.instantiate() as Node3D
	return null

## is there a model for this key (so the game can fit it: stretch a pan, find a named part)
func has_model(key: String) -> bool:
	if not _models.has(key): model(key)
	return _models[key] is PackedScene
