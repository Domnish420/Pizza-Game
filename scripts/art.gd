extends Node
## Art layer. Every picture in the game is requested here by key.
## If res://assets/<key with dots as dashes>.png exists it is used; otherwise the caller draws a placeholder shape.
## So the game is fully playable with no artwork, and art is added by dropping PNG files into assets/.
## Example: key "bg.van" -> res://assets/bg-van.png. See ART_KEYS.md for the full list.

var _cache := {}

func tex(key: String) -> Texture2D:
	if _cache.has(key):
		return _cache[key]
	var path := "res://assets/" + key.replace(".", "-") + ".png"
	var t: Texture2D = null
	if ResourceLoader.exists(path):
		t = load(path)
	_cache[key] = t
	return t

## Sound effects: res://assets/sfx/<name>.wav, generated by tools/sfx/make_sfx.py (see tools/sfx/README.md).
## vary nudges the pitch a little each time (so a run of the same sound does not sound mechanical); gap is the least
## time in seconds between two plays of it (so a finger dragging across the dough does not machine-gun).
var _players := {}
var _last := {}
func sfx(sound: String, vary := false, gap := 0.0) -> void:
	if Game.s.get("mute", false):
		return
	var now := Time.get_ticks_msec() / 1000.0
	if gap > 0.0 and now - float(_last.get(sound, -100.0)) < gap: return
	_last[sound] = now
	if not _players.has(sound):
		var path := "res://assets/sfx/" + sound + ".wav"
		var p: AudioStreamPlayer = null
		if ResourceLoader.exists(path):
			p = AudioStreamPlayer.new()
			p.stream = load(path)
			add_child(p)
		_players[sound] = p
	var pl: AudioStreamPlayer = _players[sound]
	if pl != null:
		pl.pitch_scale = randf_range(0.93, 1.07) if vary else 1.0
		pl.play()

## The background loops (fire, murmur, room): call every frame with how loud it should be, 0 (off) to 1; it eases
## there, so it swells and fades rather than jumping. stop_loops() silences them all at once (leaving the 3D world).
var _loops := {}
func loop(sound: String, level: float, dt: float = 0.016) -> void:
	if Game.s.get("mute", false): level = 0.0
	var p: AudioStreamPlayer = _loops.get(sound, null)
	if p == null:
		if level <= 0.001: return
		var path := "res://assets/sfx/" + sound + ".wav"
		if not ResourceLoader.exists(path): return
		p = AudioStreamPlayer.new()
		p.stream = load(path)
		p.volume_db = -60.0
		p.finished.connect(p.play)          # round again: the loops are made to join up without a seam
		add_child(p)
		_loops[sound] = p
	var want := linear_to_db(maxf(level, 0.0001))
	p.volume_db = lerpf(p.volume_db, want, 1.0 - exp(-dt * 3.0))
	if level > 0.001 and not p.playing: p.play(randf() * p.stream.get_length())
	elif level <= 0.001 and p.volume_db < -45.0 and p.playing: p.stop()

func stop_loops() -> void:
	for k in _loops:
		var p: AudioStreamPlayer = _loops[k]
		if p != null:
			p.stop()
			p.volume_db = -60.0

## A 3D model by key: res://assets/models/<key with dots as dashes>.glb (or .gltf / .tscn), instanced.
## null if there is none yet, and the 3D kitchen builds a placeholder shape instead. See ART_KEYS.md.
var _models := {}
func model(key: String) -> Node3D:
	if not _models.has(key):
		_models[key] = null
		for ext in [".glb", ".gltf", ".tscn"]:
			var path: String = "res://assets/models/" + key.replace(".", "-") + ext
			if ResourceLoader.exists(path):
				_models[key] = load(path)
				break
	var ps = _models[key]
	if ps is PackedScene: return ps.instantiate() as Node3D
	return null

## is there a model for this key (so the game can fit it: stretch a pan, find a named part)
func has_model(key: String) -> bool:
	if not _models.has(key): model(key)
	return _models[key] is PackedScene
