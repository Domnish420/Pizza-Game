; Engine configuration file.
config_version=5

[application]

config/name="Crust Empire"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.11, 0.165, 0.133, 1)
config/icon="res://icon.svg"

[autoload]

Data="*res://scripts/data.gd"
Art="*res://scripts/art.gd"
Stock="*res://scripts/stock.gd"
Market="*res://scripts/market.gd"
Hygiene="*res://scripts/hygiene.gd"
Day="*res://scripts/day.gd"
Checks="*res://scripts/checks.gd"
Story="*res://scripts/story.gd"
Equip="*res://scripts/equip.gd"
Game="*res://scripts/game.gd"
Tutor="*res://scripts/tutor.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[editor_plugins]

enabled=PackedStringArray("res://addons/ARCorePlugin/plugin.cfg")

[input_devices]

pointing/emulate_mouse_from_touch=true
sensors/enable_gyroscope=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.11, 0.165, 0.133, 1)

[xr]

openxr/enabled=false
openxr/enabled.quest=true
openxr/reference_space=2
openxr/foveation_level=3
openxr/foveation_dynamic=true
openxr/foveation_eye_tracked=false
openxr/startup_alert=false
openxr/extensions/hand_tracking=true
openxr/extensions/hand_interaction_profile=true
shaders/enabled=false
shaders/enabled.quest=true
