; Engine configuration file.
config_version=5

[application]

config/name="Crust Empire"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.11, 0.165, 0.133, 1)
config/icon="res://icon.svg"

[autoload]

Data="*res://scripts/data.gd"
Art="*res://scripts/art.gd"
Stock="*res://scripts/stock.gd"
Market="*res://scripts/market.gd"
Hygiene="*res://scripts/hygiene.gd"
Day="*res://scripts/day.gd"
Checks="*res://scripts/checks.gd"
Story="*res://scripts/story.gd"
Equip="*res://scripts/equip.gd"
Game="*res://scripts/game.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[input_devices]

pointing/emulate_mouse_from_touch=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.11, 0.165, 0.133, 1)
